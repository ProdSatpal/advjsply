          {
            "@type": "Question",
            "name": "What are the grounds for contested divorce?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Grounds for contested divorce include cruelty, adultery, desertion, mental disorder, or renunciation under the Hindu Marriage Act. A thorough evaluation of facts is required to build a case."
            }
          },
          {
            "@type": "Question",
            "name": "Can I get a divorce without spouse's consent?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, if one spouse can prove specific statutory grounds like cruelty or desertion, a contested divorce can be granted by the court even without the other spouse's consent."
            }
          }
        ]
      }
    ],
