        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is a legal notice?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A formal communication to inform of a grievance before legal proceedings, often a mandatory first step in India."
            }
          },
          {
            "@type": "Question",
            "name": "Can I use the draft from your tool directly?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No, the tool is for educational purposes. Notices must be reviewed and signed by Adv. Jasvinder Singh Ply for legal validity."
            }
          },
          {
            "@type": "Question",
            "name": "Why do I need a lawyer if I can draft it myself?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Precision, citations, and an advocate's signature are mandatory for a notice to have legal standing in court."
            }
          },
          {
            "@type": "Question",
            "name": "How long does it take?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Typically drafted and dispatched within 24-48 hours after consultation."
            }
          },
          {
            "@type": "Question",
            "name": "What is RPAD?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Registered Post Acknowledgement Due; it provides the official proof of delivery required in court."
            }
          },
          {
            "@type": "Question",
            "name": "Do I need to visit your office?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No, the entire process can be handled remotely and digitally."
            }
          }
        ]
