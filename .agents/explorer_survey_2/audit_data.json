          {
            "@type": "Question",
            "name": "What is the notice period for Cheque Bounce in Nagpur?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A legal notice for cheque bounce must be sent within 30 days of receiving the bank memo. The recipient has 15 days to settle the amount before criminal proceedings can begin."
            }
          },
          {
            "@type": "Question",
            "name": "Is a notice mandatory before suing a government body?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, under Section 80 of the CPC, a formal 2-month notice is mandatory before filing a lawsuit against any government body like the Nagpur Municipal Corporation (NMC)."
            }
          }
        ]
      }
